#include "bsp/esp-bsp.h"
#include "video_loop.h"
#include "palco.h"
#include "esp_err.h"
#include "esp_log.h"
#include "lvgl.h"
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include <stdio.h>
#include <string.h>

static const char *TAG = "oldskull_app";

#define DEBUG_TOUCHES 1

extern const lv_img_dsc_t amp_lonestar;
extern const lv_img_dsc_t amp_soldano;
extern const lv_img_dsc_t amp_jp2c;
extern const lv_img_dsc_t tela_palco;  // fundo steampunk da tela 2

#define TOTAL_DE_TELAS 2
#define QTD_AMPS 3

static const lv_img_dsc_t *amp_img[QTD_AMPS] = {
    &amp_lonestar, &amp_soldano, &amp_jp2c
};
static const char *amp_nome[QTD_AMPS] = { "LONESTAR", "SOLDANO", "JP-2C" };

static lv_obj_t *amp_obj[QTD_AMPS];
static int amp_atual = 0;

// forward declarations
static lv_obj_t *tela1_obj = NULL;
static lv_obj_t *tela2_obj = NULL;
static uint8_t tela_ativa = 0;
static bool tela2_montada = false;
static void trocar_tela(uint8_t nova_tela);
void app_trocar_amp(void);

static void amp_set_x(void *obj, int32_t v) { lv_obj_set_x(obj, v); }
static void amp_set_y(void *obj, int32_t v) { lv_obj_set_y(obj, v); }

static void arranjar_carrossel(void)
{
    for (int i = 0; i < QTD_AMPS; i++) {
        if (!amp_obj[i]) continue;
        int d = i - amp_atual;
        if (d < -1) d += QTD_AMPS;
        if (d >  1) d -= QTD_AMPS;

        int w = amp_img[i]->header.w;
        int cx, cy;
        if (d == 0)       { cx = 400; cy = 275; }
        else if (d == -1) { cx = 140; cy = 175; }
        else              { cx = 660; cy = 175; }

        int tx = cx - w / 2, ty = cy - 150;

        lv_obj_clear_flag(amp_obj[i], LV_OBJ_FLAG_HIDDEN);
        if (d == 0) {
            lv_obj_move_foreground(amp_obj[i]);
            lv_obj_set_style_opa(amp_obj[i], LV_OPA_COVER, 0);
        } else {
            lv_obj_move_background(amp_obj[i]);
            lv_obj_set_style_opa(amp_obj[i], LV_OPA_50, 0);
        }

        lv_anim_t ax;
        lv_anim_init(&ax);
        lv_anim_set_var(&ax, amp_obj[i]);
        lv_anim_set_time(&ax, 350);
        lv_anim_set_path_cb(&ax, lv_anim_path_ease_out);
        lv_anim_set_exec_cb(&ax, amp_set_x);
        lv_anim_set_values(&ax, lv_obj_get_x(amp_obj[i]), tx);
        lv_anim_start(&ax);

        lv_anim_t ay;
        lv_anim_init(&ay);
        lv_anim_set_var(&ay, amp_obj[i]);
        lv_anim_set_time(&ay, 350);
        lv_anim_set_path_cb(&ay, lv_anim_path_ease_out);
        lv_anim_set_exec_cb(&ay, amp_set_y);
        lv_anim_set_values(&ay, lv_obj_get_y(amp_obj[i]), ty);
        lv_anim_start(&ay);
    }
}

static void criar_carrossel(lv_obj_t *tela)
{
    lv_obj_t *cont = lv_obj_create(tela);
    lv_obj_remove_style_all(cont);
    lv_obj_set_size(cont, 800, 480);
    lv_obj_set_pos(cont, 0, 0);
    lv_obj_clear_flag(cont, LV_OBJ_FLAG_CLICKABLE);
    lv_obj_set_style_bg_opa(cont, LV_OPA_TRANSP, LV_PART_MAIN);
    lv_obj_move_foreground(cont);

    for (int i = 0; i < QTD_AMPS; i++) {
        lv_obj_t *im = lv_img_create(cont);
        lv_img_set_src(im, amp_img[i]);
        lv_obj_clear_flag(im, LV_OBJ_FLAG_CLICKABLE);
        lv_obj_clear_flag(im, LV_OBJ_FLAG_SCROLLABLE);
        amp_obj[i] = im;
    }
    arranjar_carrossel();
}

static int16_t toque_inicio_x = 0;
static int16_t toque_inicio_y = 0;
static bool toque2_valido = false;

static void evento_toque(lv_event_t *e)
{
    lv_event_code_t code = lv_event_get_code(e);
    lv_indev_t *indev = lv_indev_get_act();
    lv_point_t p;
    if (indev == NULL) return;
    lv_indev_get_point(indev, &p);

    if (code == LV_EVENT_PRESSED) {
        toque_inicio_x = p.x;
        toque_inicio_y = p.y;
        toque2_valido = true;
        #if DEBUG_TOUCHES
        ESP_LOGI(TAG, "TOQUE: x=%d y=%d (tela %d)", p.x, p.y, tela_ativa);
        #endif
        return;
    }

    if (code == LV_EVENT_RELEASED) {
        if (!toque2_valido) return;
        toque2_valido = false;
        int16_t dx = p.x - toque_inicio_x;
        int16_t dy = p.y - toque_inicio_y;
        int16_t adx = dx < 0 ? -dx : dx;
        int16_t ady = dy < 0 ? -dy : dy;

        // TELA 1 (video + carrossel): horizontal troca amp, vertical troca tela
        if (tela_ativa == 0) {
            // Horizontal domina vertical → troca amp (sempre)
            if (adx >= 40 && adx >= ady) {
                amp_atual = (amp_atual + (dx > 0 ? 1 : -1) + QTD_AMPS) % QTD_AMPS;
                arranjar_carrossel();
                ESP_LOGI(TAG, "amp: %s (swipe horizontal)", amp_nome[amp_atual]);
                return;
            }
            // Vertical pra baixo (>40px) domina horizontal → vai pra tela 2
            if (ady >= 40 && ady > adx && dy > 0) {
                trocar_tela(1);
                return;
            }
            // Toque leve no topo = pausa video
            if (adx < 20 && ady < 20 && p.y < 70) {
                video_toggle_pause();
                return;
            }
        }

        // TELA 2: vertical pra baixo (>40px) volta pra tela 1
        if (tela_ativa == 1 && ady >= 40 && ady > adx && dy > 0) {
            ESP_LOGI(TAG, "Tela 2: volta pra 1 | dy=%d ady=%d", dy, ady);
            trocar_tela(0);
            return;
        }
    }
}

static lv_obj_t *criar_tela(void)
{
    lv_obj_t *tela = lv_obj_create(NULL);
    lv_obj_clear_flag(tela, LV_OBJ_FLAG_SCROLLABLE);
    lv_obj_set_scrollbar_mode(tela, LV_SCROLLBAR_MODE_OFF);
    lv_obj_set_style_bg_color(tela, lv_color_black(), LV_PART_MAIN);
    lv_obj_set_style_bg_opa(tela, LV_OPA_COVER, LV_PART_MAIN);
    lv_obj_set_style_border_width(tela, 0, LV_PART_MAIN);
    lv_obj_set_style_pad_all(tela, 0, LV_PART_MAIN);

    lv_obj_add_flag(tela, LV_OBJ_FLAG_CLICKABLE);
    lv_obj_add_event_cb(tela, evento_toque, LV_EVENT_PRESSED, NULL);
    lv_obj_add_event_cb(tela, evento_toque, LV_EVENT_RELEASED, NULL);
    return tela;
}

// Swipe entre telas: manipulado manualmente em evento_toque (PRESSED/RELEASED)
// Mais sensível que LV_EVENT_GESTURE do LVGL

static lv_obj_t *criar_tela2(void)
{
    // Tela base: remove CLICKABLE para deixar eventos fluir pros filhos (botões, menus)
    // Apenas mantém LV_EVENT_GESTURE ativo via callback de gesto
    lv_obj_t *tela = lv_obj_create(NULL);
    lv_obj_clear_flag(tela, LV_OBJ_FLAG_SCROLLABLE);
    lv_obj_set_scrollbar_mode(tela, LV_SCROLLBAR_MODE_OFF);
    lv_obj_set_style_bg_color(tela, lv_color_black(), LV_PART_MAIN);
    lv_obj_set_style_bg_opa(tela, LV_OPA_COVER, LV_PART_MAIN);
    lv_obj_set_style_border_width(tela, 0, LV_PART_MAIN);
    lv_obj_set_style_pad_all(tela, 0, LV_PART_MAIN);
    lv_obj_clear_flag(tela, LV_OBJ_FLAG_CLICKABLE);  // DEIXA eventos fluir pros filhos

    // imagem de fundo do palco steampunk (800x480) — BACKGROUND
    lv_obj_t *img = lv_img_create(tela);
    lv_img_set_src(img, &tela_palco);
    lv_obj_set_size(img, tela_palco.header.w, tela_palco.header.h);
    lv_obj_set_pos(img, 0, 0);
    lv_obj_clear_flag(img, LV_OBJ_FLAG_CLICKABLE);
    lv_obj_clear_flag(img, LV_OBJ_FLAG_SCROLLABLE);

    // Registra touch na tela2: swipe horizontal volta pra tela 1
    lv_obj_add_flag(tela, LV_OBJ_FLAG_CLICKABLE);
    lv_obj_add_event_cb(tela, evento_toque, LV_EVENT_PRESSED, NULL);
    lv_obj_add_event_cb(tela, evento_toque, LV_EVENT_RELEASED, NULL);

    // --- Ícones clicáveis: SISTEMA + NOME ---
    lv_obj_add_flag(tela, LV_OBJ_FLAG_CLICKABLE);

    // Ícone SISTEMA (canto inferior esq)
    lv_obj_t *btn_sistema = lv_obj_create(tela);
    lv_obj_remove_style_all(btn_sistema);
    lv_obj_set_size(btn_sistema, 120, 50);
    lv_obj_align(btn_sistema, LV_ALIGN_BOTTOM_LEFT, 16, -16);
    lv_obj_set_style_bg_color(btn_sistema, lv_color_hex(0x2A1E08), LV_PART_MAIN);
    lv_obj_set_style_bg_opa(btn_sistema, LV_OPA_85, LV_PART_MAIN);
    lv_obj_set_style_border_width(btn_sistema, 1, LV_PART_MAIN);
    lv_obj_set_style_border_color(btn_sistema, lv_color_hex(0xF3C969), LV_PART_MAIN);
    lv_obj_set_style_radius(btn_sistema, 6, LV_PART_MAIN);
    lv_obj_add_flag(btn_sistema, LV_OBJ_FLAG_CLICKABLE);
    lv_obj_clear_flag(btn_sistema, LV_OBJ_FLAG_SCROLLABLE);
    lv_obj_add_event_cb(btn_sistema, evento_click_icones, LV_EVENT_PRESSED, (void *)"SISTEMA");
    lv_obj_add_event_cb(btn_sistema, evento_click_icones, LV_EVENT_RELEASED, (void *)"SISTEMA");
    lv_obj_t *lbl_sist = lv_label_create(btn_sistema);
    lv_label_set_text(lbl_sist, LV_SYMBOL_SETTINGS" SISTEMA");
    lv_obj_set_style_text_font(lbl_sist, &lv_font_montserrat_20, LV_PART_MAIN);
    lv_obj_set_style_text_color(lbl_sist, lv_color_hex(0xF3C969), LV_PART_MAIN);
    lv_obj_center(lbl_sist);

    // Ícone NOME (canto inferior dir)
    lv_obj_t *btn_nome = lv_obj_create(tela);
    lv_obj_remove_style_all(btn_nome);
    lv_obj_set_size(btn_nome, 120, 50);
    lv_obj_align(btn_nome, LV_ALIGN_BOTTOM_RIGHT, -16, -16);
    lv_obj_set_style_bg_color(btn_nome, lv_color_hex(0x2A1E08), LV_PART_MAIN);
    lv_obj_set_style_bg_opa(btn_nome, LV_OPA_85, LV_PART_MAIN);
    lv_obj_set_style_border_width(btn_nome, 1, LV_PART_MAIN);
    lv_obj_set_style_border_color(btn_nome, lv_color_hex(0xF3C969), LV_PART_MAIN);
    lv_obj_set_style_radius(btn_nome, 6, LV_PART_MAIN);
    lv_obj_add_flag(btn_nome, LV_OBJ_FLAG_CLICKABLE);
    lv_obj_clear_flag(btn_nome, LV_OBJ_FLAG_SCROLLABLE);
    lv_obj_add_event_cb(btn_nome, evento_click_icones, LV_EVENT_PRESSED, (void *)"NOME");
    lv_obj_add_event_cb(btn_nome, evento_click_icones, LV_EVENT_RELEASED, (void *)"NOME");
    lv_obj_t *lbl_nome = lv_label_create(btn_nome);
    lv_label_set_text(lbl_nome, LV_SYMBOL_EDIT" NOME");
    lv_obj_set_style_text_font(lbl_nome, &lv_font_montserrat_20, LV_PART_MAIN);
    lv_obj_set_style_text_color(lbl_nome, lv_color_hex(0xF3C969), LV_PART_MAIN);
    lv_obj_center(lbl_nome);

    return tela;
}

static void trocar_tela(uint8_t nova_tela)
{
    if (nova_tela >= TOTAL_DE_TELAS) return;

    tela_ativa = nova_tela;

    // Monta menus da tela 2 LAZY (quando chega pela primeira vez)
    if (nova_tela == 1 && !tela2_montada) {
        palco_montar(tela2_obj);
        tela2_montada = true;
    }

    if (bsp_display_lock(500)) {
        lv_scr_load_anim(
            (nova_tela == 0) ? tela1_obj : tela2_obj,
            (nova_tela == 0) ? LV_SCR_LOAD_ANIM_MOVE_RIGHT : LV_SCR_LOAD_ANIM_MOVE_LEFT,
            300, 0, false
        );
        bsp_display_unlock();
    }
}

// botao "Trocar Amp" do menu (chamado por palco.c)
void app_trocar_amp(void);

/* ---- tela 2: forward declarations ---- */
static void limpar_overlays(void);
static void abrir_submenu_sistema(void);
static void abrir_teclado(void);
static void evento_click_icones(lv_event_t *e);

/* ---- tela 2: 2 icones clicaveis (SISTEMA + NOME) ---- */

static void limpar_overlays(void)
{
    lv_obj_t *scr = lv_scr_act();
    uint32_t n = lv_obj_get_child_cnt(scr);
    for (uint32_t i = n; i > 1; i--) {
        lv_obj_t *child = lv_obj_get_child(scr, i - 1);
        if (child) lv_obj_del(child);
    }
}

static void abrir_submenu_sistema(void)
{
    limpar_overlays();
    lv_obj_t *scr = lv_scr_act();
    lv_obj_t *painel = lv_obj_create(scr);
    lv_obj_remove_style_all(painel);
    lv_obj_set_size(painel, 220, 120);
    lv_obj_align(painel, LV_ALIGN_TOP_RIGHT, -20, 60);
    lv_obj_set_style_bg_color(painel, lv_color_hex(0x2A1E08), LV_PART_MAIN);
    lv_obj_set_style_bg_opa(painel, LV_OPA_90, LV_PART_MAIN);
    lv_obj_set_style_border_width(painel, 1, LV_PART_MAIN);
    lv_obj_set_style_border_color(painel, lv_color_hex(0xFFA030), LV_PART_MAIN);
    lv_obj_set_style_radius(painel, 4, LV_PART_MAIN);

    lv_obj_t *lbl = lv_label_create(painel);
    lv_label_set_text(lbl, "SUBMENU SISTEMA");
    lv_obj_set_style_text_color(lbl, lv_color_hex(0xF3C969), LV_PART_MAIN);
    lv_obj_center(lbl);

    lv_obj_add_flag(painel, LV_OBJ_FLAG_CLICKABLE);
    lv_obj_add_event_cb(painel, (lv_event_cb_t)limpar_overlays, LV_EVENT_CLICKED, NULL);
}

static void abrir_teclado(void)
{
    limpar_overlays();
    lv_obj_t *scr = lv_scr_act();
    lv_obj_t *ta = lv_textarea_create(scr);
    lv_obj_set_size(ta, 400, 50);
    lv_obj_align(ta, LV_ALIGN_TOP_MID, 0, 30);
    lv_obj_set_style_bg_color(ta, lv_color_hex(0x151008), LV_PART_MAIN);
    lv_obj_set_style_border_color(ta, lv_color_hex(0xF3C969), LV_PART_MAIN);
    lv_obj_set_style_border_width(ta, 2, LV_PART_MAIN);
    lv_obj_set_style_text_color(ta, lv_color_hex(0xF3C969), LV_PART_MAIN);

    lv_obj_t *kb = lv_keyboard_create(scr);
    lv_obj_set_size(kb, 800, 280);
    lv_obj_align(kb, LV_ALIGN_BOTTOM_MID, 0, 0);
    lv_obj_set_style_bg_color(kb, lv_color_hex(0x241A0A), LV_PART_MAIN);
    lv_obj_set_style_bg_opa(kb, LV_OPA_90, LV_PART_MAIN);
    lv_obj_set_style_text_color(kb, lv_color_hex(0xF3C969), LV_PART_MAIN);
    lv_keyboard_set_textarea(kb, ta);
}

static void evento_click_icones(lv_event_t *e)
{
    lv_event_code_t code = lv_event_get_code(e);
    lv_indev_t *indev = lv_indev_get_act();
    static lv_point_t pt_inicio;

    if (code == LV_EVENT_PRESSED && indev) {
        lv_indev_get_point(indev, &pt_inicio);
        return;
    }
    if (code != LV_EVENT_RELEASED || !indev) return;
    lv_point_t pt_fim;
    lv_indev_get_point(indev, &pt_fim);
    int16_t dx = pt_fim.x - pt_inicio.x;
    int16_t dy = pt_fim.y - pt_inicio.y;
    if ((dx*dx + dy*dy) > 16*16) return;  // ignora swipes

    const char *nome = (const char *)lv_event_get_user_data(e);
    if (strcmp(nome, "SISTEMA") == 0) {
        abrir_submenu_sistema();
    } else if (strcmp(nome, "NOME") == 0) {
        abrir_teclado();
    }
}


void app_main(void)
{
    ESP_LOGI(TAG, "Inicializando display JC4880P433C...");

    // Config oficial do demo lvgl_sw_rotation (fábrica):
    // buff_dma=false, buff_spiram=false, sw_rotate=true
    bsp_display_cfg_t cfg = {
        .lvgl_port_cfg = ESP_LVGL_PORT_INIT_CONFIG(),
        .buffer_size = CONFIG_BSP_JC4880P443C_LVGL_BUFFER_SIZE,
        .double_buffer = CONFIG_BSP_JC4880P443C_LVGL_DOUBLE_BUFFER,
        .flags = {
            .buff_dma = false,
            .buff_spiram = false,
            .sw_rotate = true,
        }
    };

    lv_display_t *display = bsp_display_start_with_config(&cfg);
    if (display == NULL) {
        ESP_LOGE(TAG, "Falha ao inicializar o display");
        return;
    }
    ESP_ERROR_CHECK(bsp_display_backlight_on());
    // Rotação via LVGL (90°) — demo oficial da fábrica
    lv_disp_set_rotation(display, LV_DISPLAY_ROTATION_90);

    // LVGL detecta gestos (swipe) automaticamente via LV_EVENT_GESTURE
    // não existe lv_indev_set_gesture_enabled na ESP-IDF 5.5.4 / LVGL 9.x

    if (bsp_display_lock(1000)) {
        // TELA 1: video + carrossel (inalterada)
        tela1_obj = criar_tela();
        video_loop_start(tela1_obj);
        criar_carrossel(tela1_obj);

        // TELA 2: fundo steampunk (menus montados LAZY no trocar_tela)
        tela2_obj = criar_tela2();

        // LV_EVENT_GESTURE no grupo_ui da tela 2 pra voltar pra tela 1
        // (montado depois do palco_montar — veja trocar_tela)

        lv_scr_load(tela1_obj);  // default: tela 1 (video)
        bsp_display_unlock();
        ESP_LOGI(TAG, "2 telas prontas | tela1: video+carrossel, tela2: palco+menus");
    }

    while (1) {
        vTaskDelay(pdMS_TO_TICKS(1000));
    }
}