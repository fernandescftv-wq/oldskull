/* --- Botão circular com efeito de glow (estilo pedaleira pro) */
static lv_obj_t *criar_botao_circular(lv_obj_t *pai, const char *txt,
                                      lv_align_t align, int32_t x, int32_t y,
                                      lv_event_cb_t cb, void *user_data)
{
    lv_obj_t *btn = lv_btn_create(pai);
    lv_obj_remove_style_all(btn);
    lv_obj_set_size(btn, 84, 84);
    lv_obj_align(btn, align, x, y);

    /* Glow effect */
    static lv_style_t style_btn;
    lv_style_init(&style_btn);
    lv_style_set_bg_color(&style_btn, lv_color_hex(0x2A1E08));
    lv_style_set_bg_opa(&style_btn, LV_OPA_90);
    lv_style_set_border_width(&style_btn, 2);
    lv_style_set_border_color(&style_btn, lv_color_hex(OURO));
    lv_style_set_border_opa(&style_btn, LV_OPA_80);
    lv_style_set_radius(&style_btn, 42);
    lv_style_set_pad_all(&style_btn, 0);
    lv_obj_add_style(btn, &style_btn, 0);

    lv_obj_clear_flag(btn, LV_OBJ_FLAG_SCROLLABLE);
    lv_obj_add_event_cb(btn, cb, LV_EVENT_CLICKED, user_data);

    /* Label */
    lv_obj_t *lbl = lv_label_create(btn);
    lv_label_set_text(lbl, txt);
    lv_obj_set_style_text_font(lbl, &fonte_menu_22, LV_PART_MAIN);
    lv_obj_set_style_text_color(lbl, lv_color_hex(OURO_CLARO), LV_PART_MAIN);
    lv_obj_center(lbl);

    return btn;
}

