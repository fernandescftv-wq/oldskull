static void estilo_painel(lv_obj_t *o)
{
    lv_obj_set_style_bg_color(o, lv_color_hex(FUNDO_PAN), LV_PART_MAIN);
    lv_obj_set_style_bg_opa(o, LV_OPA_70, LV_PART_MAIN);
