    lv_obj_align(btn_pres_off, LV_ALIGN_LEFT_MID, 270, 10);
    lv_label_set_text(lv_label_create(btn_pres_off), "OFF");
    lv_obj_add_event_cb(btn_pres_off, modo_preset_handler, LV_EVENT_CLICKED, (void*)0);

    /* Botão fechar */
    lv_obj_t *btn_close = lv_btn_create(panel);
    lv_obj_align(btn_close, LV_ALIGN_BOTTOM_RIGHT, -12, -12);
    lv_obj_set_size(btn_close, 60, 36);
    lv_obj_set_style_bg_color(btn_close, lv_color_hex(0x8A6420), LV_PART_MAIN);
    lv_obj_set_style_radius(btn_close, 6, LV_PART_MAIN);
    lv_label_set_text(lv_label_create(btn_close), "FECHAR");
    lv_obj_add_event_cb(btn_close, fechar_overlay_handler, LV_EVENT_CLICKED, ov);
}

/* --- Handlers auxiliares --- */
static void velocidade_handler(lv_event_t *e)
{
    int fps = (int)(intptr_t)lv_event_get_user_data(e);
    video_set_fps(fps);
    velocidade_atual = fps;
    ESP_LOGI(TAG, "Video FPS: %d", fps);
}

static void modo_stomp_handler(lv_event_t *e) {
    int on = (int)(intptr_t)lv_event_get_user_data(e);
    ESP_LOGI(TAG, "Stomp Mode: %s", on ? "ON" : "OFF");
}

static void modo_preset_handler(lv_event_t *e) {
    int on = (int)(intptr_t)lv_event_get_user_data(e);
    ESP_LOGI(TAG, "Preset Mode: %s", on ? "ON" : "OFF");
}

static void fechar_overlay_handler(lv_event_t *e)
{
    lv_obj_t *ov = (lv_obj_t *)lv_event_get_user_data(e);
    if (ov) lv_obj_del(ov);
    /* delete o panel too (é filho do scr, mas overlay some) */
    lv_obj_t *scr = lv_scr_act();
    uint32_t n = lv_obj_get_child_cnt(scr);
    for (uint32_t i = 0; i < n; i++) {
        lv_obj_t *child = lv_obj_get_child(scr, i);
        if (child && lv_obj_get_parent(child) == scr) {
            /* panel é o único overlay grande */
            lv_obj_t *p = lv_obj_get_child(scr, i);
            if (p != ov && p != NULL) {
                /* verifica se é o panel pelo tamanho */
                if (lv_obj_get_width(p) > 300 && lv_obj_get_height(p) > 200) {
                    lv_obj_del(p);
                    break;
                }
            }
        }
    }
    /* volta pro video bg */
    sd_fundos_esconder();
}

/* --- Teclado popup (abre sobre a tela) --- */
static void abrir_teclado_popup(void)
{
    teclado_box = lv_obj_create(lv_scr_act());
    lv_obj_remove_style_all(teclado_box);
    lv_obj_set_size(teclado_box, 800, 480);
    lv_obj_set_pos(teclado_box, 0, 0);
    lv_obj_set_style_bg_color(teclado_box, lv_color_black(), LV_PART_MAIN);
    lv_obj_set_style_bg_opa(teclado_box, LV_OPA_90, LV_PART_MAIN);
    lv_obj_clear_flag(teclado_box, LV_OBJ_FLAG_SCROLLABLE);

    lv_obj_t *titulo = texto(teclado_box, "NOME DO PRESET",
                             &fonte_menu_22, OURO);
    lv_obj_set_style_text_letter_space(titulo, 3, LV_PART_MAIN);
    lv_obj_align(titulo, LV_ALIGN_TOP_MID, 0, 8);

    ta_nome = lv_textarea_create(teclado_box);
    lv_textarea_set_one_line(ta_nome, true);
    lv_textarea_set_max_length(ta_nome, sizeof(nome_preset) - 1);
    lv_textarea_set_text(ta_nome, nome_preset);
    lv_obj_set_size(ta_nome, 520, 50);
    lv_obj_align(ta_nome, LV_ALIGN_TOP_MID, 0, 38);
    lv_obj_set_style_bg_color(ta_nome, lv_color_hex(0x151008), LV_PART_MAIN);
    lv_obj_set_style_border_color(ta_nome, lv_color_hex(OURO), LV_PART_MAIN);
    lv_obj_set_style_border_width(ta_nome, 2, LV_PART_MAIN);
    lv_obj_set_style_text_color(ta_nome, lv_color_hex(OURO_CLARO), LV_PART_MAIN);
    lv_obj_set_style_text_font(ta_nome, &fonte_menu_26, LV_PART_MAIN);

    lv_obj_t *kb = lv_keyboard_create(teclado_box);
    lv_obj_set_size(kb, 800, 372);
    lv_obj_align(kb, LV_ALIGN_BOTTOM_MID, 0, 0);
    lv_keyboard_set_mode(kb, LV_KEYBOARD_MODE_TEXT_UPPER);
    lv_keyboard_set_textarea(kb, ta_nome);
    lv_obj_set_style_bg_color(kb, lv_color_hex(0x0E0A04), LV_PART_MAIN);
    lv_obj_set_style_text_color(kb, lv_color_hex(OURO_CLARO), LV_PART_ITEMS);
    lv_obj_set_style_bg_color(kb, lv_color_hex(0x241A0A), LV_PART_ITEMS);
    lv_obj_set_style_border_color(kb, lv_color_hex(OURO_ESCURO), LV_PART_ITEMS);
    lv_obj_set_style_border_width(kb, 1, LV_PART_ITEMS);
    lv_obj_add_event_cb(kb, ev_teclado_handler, LV_EVENT_READY, NULL);
    lv_obj_add_event_cb(kb, ev_teclado_handler, LV_EVENT_CANCEL, NULL);
}

static void ev_teclado_handler(lv_event_t *e)
{
    lv_event_code_t code = lv_event_get_code(e);
    if (code == LV_EVENT_READY) {
        const char *t = lv_textarea_get_text(ta_nome);
        if (t && t[0]) {
            strncpy(nome_preset, t, sizeof(nome_preset) - 1);
            nome_preset[sizeof(nome_preset) - 1] = '\0';
            if (lbl_preset) lv_label_set_text(lbl_preset, nome_preset);
            ESP_LOGI(TAG, "preset salvo: %s", nome_preset);
        }
        fechar_teclado_local();
    } else if (code == LV_EVENT_CANCEL) {
        fechar_teclado_local();
    }
}

static void fechar_teclado_local(void)
{
    if (teclado_box) {
        lv_obj_del(teclado_box);
        teclado_box = NULL;
        ta_nome = NULL;
    }
}

/* --- Função principal chamada pelo app_main --- */
void palco_montar(lv_obj_t *tela)
{
    /* Fundo do SD (se disponível) ou mantém video */
    fundo_t atual = sd_fundos_atual();
    if (atual == FUNDO_VIDEO) {
        /* Tenta fundo do SD */
        sd_fundos_mostrar(tela, FUNDO_SD_1);
    }

    /* Header: NOME DO PRESET */
    lbl_preset = lv_label_create(tela);
    lv_obj_set_style_text_font(lbl_preset, &fonte_playfair_40, LV_PART_MAIN);
    lv_label_set_text_fmt(lbl_preset, "PRESET: %s", nome_preset);
    lv_obj_set_style_text_color(lbl_preset, lv_color_hex(OURO_CLARO), LV_PART_MAIN);
    lv_obj_align(lbl_preset, LV_ALIGN_TOP_MID, 0, 8);

    /* Menu circular principal: 4 ícones */
    criar_botao_circular(tela, "NOME", LV_ALIGN_BOTTOM_LEFT, 30, -30,
                         menu_nome_handler, NULL);
    criar_botao_circular(tela, "SISTEMA", LV_ALIGN_BOTTOM_RIGHT, -30, -30,
                         menu_sistema_handler, NULL);
    criar_botao_circular(tela, "MIDI", LV_ALIGN_TOP_LEFT, 30, 30,
                         menu_midi_handler, NULL);
    criar_botao_circular(tela, "IMP.", LV_ALIGN_TOP_RIGHT, -30, 30,
                         menu_implementacao_handler, NULL);

    ESP_LOGI(TAG, "Menu profissional montado (Nome, Sistema, MIDI, Implementaçāo)");
}

